{
  "name": "lab-status",
  "version": "1.0.1",
  "private": true,
  "description": "Lab status: whether the homelab's public services are up, for morganvanv.com's Lab page. One Cloudflare Worker.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:worker": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm test && npm run build",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "vitest": "^5.0.5",
    "wrangler": "4.156.0"
  }
}
