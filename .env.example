# Copy to .env (gitignored) and fill in. Keep every key, and give every one a value: doctl refuses an empty
# substitution ("The following substitutions could not be resolved"). Use `off` to switch something off.

# Where ask/submit sends submissions.
DISCORD_WEBHOOK_URL=

# "Publish as PR" (README). The public URL of ask/publish (the ask/submit URL with `publish` for `submit`;
# doctl serverless functions get ask/publish --url), or `off` for no links.
PUBLISH_URL=off
# openssl rand -hex 32
PUBLISH_SECRET=off
# Fine-grained token: this one repository; Contents and Pull requests read/write (Metadata read comes with it).
GITHUB_TOKEN=off
# The site's repo. (`off` falls back to morgan-vanv/morganvanv.com.)
GITHUB_REPO=morgan-vanv/morganvanv.com
