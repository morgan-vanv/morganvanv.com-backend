# Copy to .env (gitignored) and fill in. Keep every key, even when it's empty.

# Where ask/submit sends submissions.
DISCORD_WEBHOOK_URL=

# "Publish as PR" (README). Leave PUBLISH_URL empty to turn it off, and keep it empty until the site side is merged.
# The public URL of ask/publish: doctl serverless functions get ask/publish --url
PUBLISH_URL=
# openssl rand -hex 32
PUBLISH_SECRET=
# Fine-grained token: this one repository; Contents and Pull requests read/write (Metadata read comes with it).
GITHUB_TOKEN=
# Empty means morgan-vanv/morganvanv.com.
GITHUB_REPO=
