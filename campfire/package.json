{
  "name": "campfire",
  "version": "1.1.0",
  "private": true,
  "description": "The visitor counter and shoutbox behind morganvanv.com: one Cloudflare Worker, one SQLite-backed Durable Object.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "^5.20261027.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "4.153.0"
  }
}
