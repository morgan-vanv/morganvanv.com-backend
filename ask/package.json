{
  "name": "ask",
  "version": "2.1.0",
  "private": true,
  "description": "Ask Morgan: forwards morganvanv.com's Contact form to Discord and turns approved suggestions into PRs. One Cloudflare Worker.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:worker": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm test && npm run build",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "vitest": "^5.0.5",
    "wrangler": "4.153.0"
  }
}
